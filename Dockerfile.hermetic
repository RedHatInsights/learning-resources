# Hermetic multi-stage build for learning-resources
# Builder: Cachi2 prefetched npm dependencies (npm ci --offline)
# Runtime: Caddy-based static file serving (same as regular build)
#
# Usage in .tekton PipelineRun:
#   - name: dockerfile
#     value: Dockerfile.hermetic
#   - name: hermetic
#     value: "true"
#   - name: prefetch-input
#     value: '{"type": "npm", "path": "."}'

# ────────── NODE.JS VERSION CONFIGURATION ──────────
ARG NODE_BUILD_VERSION=22
ARG NODE_IMAGE_TAG=9.8-1780375952
FROM registry.access.redhat.com/ubi9/nodejs-${NODE_BUILD_VERSION}:${NODE_IMAGE_TAG} AS builder

# Additional arguments for npm ci (e.g. "--legacy-peer-deps")
ARG NPM_CI_ARGS=

# ────────── SENTRY BUILD ARGS ──────────
ARG ENABLE_SENTRY=false
ARG SENTRY_AUTH_TOKEN
ARG SENTRY_RELEASE
ENV ENABLE_SENTRY=${ENABLE_SENTRY} \
    SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN} \
    SENTRY_RELEASE=${SENTRY_RELEASE}

# ────────── APP VERSION ──────────
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

# Copy package files first for better layer caching
COPY --chown=default package*.json ./

# Install dependencies from Cachi2 prefetch cache
# CYPRESS_INSTALL_BINARY=0 prevents Cypress binary download attempt in hermetic env
RUN CYPRESS_INSTALL_BINARY=0 npm ci --offline --no-audit --no-fund $NPM_CI_ARGS

# Copy source code
COPY --chown=default . .

# Build the frontend application
RUN npm run build

# ────────── RUNTIME STAGE ──────────
# Caddy-based runtime preserves existing deployment behavior, e2e test
# compatibility, and serving configuration from the regular (non-hermetic) build.
FROM quay.io/redhat-services-prod/hcm-eng-prod-tenant/caddy-ubi:latest

COPY LICENSE /licenses/

ENV CADDY_TLS_MODE http_port 8000
ENV ENV_PUBLIC_PATH "/default"

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /opt/app-root/src/dist dist
COPY package.json .
